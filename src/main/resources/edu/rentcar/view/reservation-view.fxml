<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns:fx="http://javafx.com/fxml/1" fx:controller="edu.rentcar.controller.ReservationController" spacing="14">
    <Label text="Rental Reservation" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>

    <VBox spacing="12" style="-fx-background-color: white; -fx-padding: 20; -fx-background-radius: 8;">
        <Label text="Create a new rental reservation" style="-fx-font-size: 15px; -fx-font-weight: bold;"/>

        <GridPane hgap="12" vgap="12">
            <Label text="Customer:" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
            <ComboBox fx:id="customerComboBox" prefWidth="280" GridPane.columnIndex="1" GridPane.rowIndex="0"/>

            <Label text="Vehicle:" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
            <ComboBox fx:id="vehicleComboBox" prefWidth="280" GridPane.columnIndex="1" GridPane.rowIndex="1"/>

            <Label text="Start Date:" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
            <DatePicker fx:id="startDatePicker" prefWidth="280" GridPane.columnIndex="1" GridPane.rowIndex="2"/>

            <Label text="End Date:" GridPane.columnIndex="0" GridPane.rowIndex="3"/>
            <DatePicker fx:id="endDatePicker" prefWidth="280" GridPane.columnIndex="1" GridPane.rowIndex="3"/>

            <Label text="Payment Token:" GridPane.columnIndex="0" GridPane.rowIndex="4"/>
            <TextField fx:id="paymentTokenField" promptText="tok_approved" prefWidth="280" GridPane.columnIndex="1" GridPane.rowIndex="4"/>
        </GridPane>

        <HBox spacing="10" style="-fx-padding: 10 0 0 0;">
            <Button text="Process Reservation" onAction="#processReservation" style="-fx-background-color: #2457a7; -fx-text-fill: white; -fx-font-weight: bold;"/>
        </HBox>
    </VBox>
</VBox>